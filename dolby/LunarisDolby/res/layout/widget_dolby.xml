<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/system_accent2_100"
    android:orientation="vertical"
    android:padding="12dp"
    android:theme="@android:style/Theme.DeviceDefault.DayNight">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textColor="@android:color/system_neutral1_900"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="@android:color/system_neutral1_800" />

    <TextView
        android:id="@+id/widget_automation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="@android:color/system_neutral1_600" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="12dp"
            android:text="@string/dolby_enable"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@android:color/system_accent1_700"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_cycle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="12dp"
            android:text="@string/widget_cycle_profile"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@android:color/system_accent1_700"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_sleep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_sleep_timer"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@android:color/system_accent1_700"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
